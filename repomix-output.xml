      const result =
        await searchFarmParcels({
          district:
            district.trim() || undefined,

          village:
            village.trim() || undefined,

          road_name:
            road.trim() || undefined,

          landmark_name:
            landmark.trim() || undefined,

          limit: 10,
        });

      setCandidates(
        result.candidates,
      );

      setSearched(true);

    } catch (err) {

      setError(
        err instanceof Error
          ? err.message
          : "Search failed.",
      );

    } finally {

      setLoading(false);
    }
  }


  function handleReset() {

    setCandidates([]);
    setSearched(false);
    setError("");
  }


  return (
    <div className="space-y-5">

