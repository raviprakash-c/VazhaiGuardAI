from __future__ import annotations

import json
import os
import re
from pathlib import Path
from typing import Any, Dict, List, Optional

from shapely.geometry import Point, shape


BASE_DIR = Path(__file__).resolve().parents[1]

GEOSPATIAL_DIR = BASE_DIR / "data" / "geospatial"


# Put the FarmwiseAI files here:
#
# backend/
#   data/
#     geospatial/
#       Park_Cadastral_Map.geojson
#       Park_fmb_Map.geojson


PROPERTY_ALIASES = {
    "district": [
        "district",
        "District",
        "DISTRICT",
        "district_name",
        "District_Name",
    ],
    "taluk": [
        "taluk",
        "Taluk",
        "TALUK",
        "taluk_name",
        "Taluk_Name",
    ],
    "village": [
        "village",
        "Village",
        "VILLAGE",
        "village_name",
        "Village_Name",
    ],
    "survey_number": [
        "survey_number",
        "survey_no",
        "Survey_No",
        "survey",
        "Survey",
        "SURVEY_NO",
    ],
    "subdivision": [
        "subdivision",
        "sub_division",
        "subdivision_number",
        "Sub_Division",
        "subdivision_no",
    ],
    "area_acres": [
        "area_acres",
        "Area_Acres",
        "acres",
        "extent_acres",
    ],
    "parcel_id": [
        "parcel_id",
        "parcel_no",
        "Parcel_ID",
        "id",
        "ID",
        "OBJECTID",
        "objectid",
    ],
}


def normalize_text(value: Any) -> str:
    if value is None:
        return ""

    text = str(value).strip().lower()

    text = re.sub(r"[^a-z0-9\u0B80-\u0BFF\s]", " ", text)
    text = re.sub(r"\s+", " ", text)

    return text


def get_property(properties: Dict[str, Any], field: str) -> Optional[Any]:
    aliases = PROPERTY_ALIASES.get(field, [])

    for alias in aliases:
        if alias in properties:
            value = properties[alias]

            if value is not None and str(value).strip():
                return value

    normalized_lookup = {
        normalize_text(key).replace(" ", "_"): value
        for key, value in properties.items()
    }

    for alias in aliases:
        normalized_alias = normalize_text(alias).replace(" ", "_")

        if normalized_alias in normalized_lookup:
            return normalized_lookup[normalized_alias]

    return None


def load_geojson_files() -> List[Dict[str, Any]]:
    features: List[Dict[str, Any]] = []

    if not GEOSPATIAL_DIR.exists():
        return features

    for path in GEOSPATIAL_DIR.glob("*.geojson"):
        try:
            with open(path, "r", encoding="utf-8") as file:
                data = json.load(file)

            if data.get("type") != "FeatureCollection":
                continue

            for feature in data.get("features", []):
                if not feature.get("geometry"):
                    continue

                feature_copy = dict(feature)

                properties = dict(
                    feature_copy.get("properties") or {}
                )

                properties["_source_file"] = path.name

                feature_copy["properties"] = properties

                features.append(feature_copy)

        except Exception as error:
            print(
                f"Could not load GeoJSON {path.name}: {error}"
            )

    return features


def text_matches(
    actual: Optional[Any],
    requested: Optional[str],
) -> bool:

    if not requested:
        return True

    if actual is None:
        return False

    actual_text = normalize_text(actual)
    requested_text = normalize_text(requested)

    if not actual_text or not requested_text:
        return False

    return (
        requested_text in actual_text
        or actual_text in requested_text
    )


def build_candidate(
    feature: Dict[str, Any],
    request,
) -> Optional[Dict[str, Any]]:

    properties = feature.get("properties") or {}
    geometry = feature.get("geometry")

    if not geometry:
        return None

    district = get_property(properties, "district")
    taluk = get_property(properties, "taluk")
    village = get_property(properties, "village")
    survey_number = get_property(
        properties,
        "survey_number",
    )
    subdivision = get_property(
        properties,
        "subdivision",
    )
    area_acres = get_property(
        properties,
        "area_acres",
    )
    parcel_id = get_property(
        properties,
        "parcel_id",
    )

    score = 0.0
    reasons: List[str] = []

    # Administrative matching
    if request.district:

        if text_matches(
            district,
            request.district,
        ):
            score += 30
            reasons.append("district matched")
        else:
            return None

    if request.taluk:

        if text_matches(
            taluk,
            request.taluk,
        ):
            score += 25
            reasons.append("taluk matched")
        else:
            return None

    if request.village:

        if text_matches(
            village,
            request.village,
        ):
            score += 25
            reasons.append("village matched")
        else:
            return None

    # Landmark/road matching is handled separately
    # when GIS layers are available.

    try:
        if area_acres is not None:
            area_acres = float(area_acres)
    except Exception:
        area_acres = None

    if not parcel_id:
        parcel_id = (
            survey_number
            or subdivision
            or f"parcel-{id(feature)}"
        )

    return {
        "parcel_id": str(parcel_id),
        "district": district,
        "taluk": taluk,
        "village": village,
        "survey_number": (
            str(survey_number)
            if survey_number is not None
            else None
        ),
        "subdivision": (
            str(subdivision)
            if subdivision is not None
            else None
        ),
        "area_acres": area_acres,
        "confidence": min(score / 100.0, 0.99),
        "match_reasons": reasons,
        "geometry": geometry,
    }


def search_parcels(request) -> List[Dict[str, Any]]:

    features = load_geojson_files()

    candidates: List[Dict[str, Any]] = []

    for feature in features:

        candidate = build_candidate(
            feature,
            request,
        )

        if candidate:
            candidates.append(candidate)

    candidates.sort(
        key=lambda item: item["confidence"],
        reverse=True,
    )

    return candidates[: request.limit]
