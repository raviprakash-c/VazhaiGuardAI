export type VoiceLanguage =
  | "ta-IN"
  | "en-IN";


export type RegistrationField =
  | "farm_name"
  | "total_farm_acres"
  | "banana_area_acres"
  | "banana_variety"
  | "planting_age"
  | "approximate_plants"
  | "drainage"
  | "support"
  | "accessibility"
  | "complete";


export interface VoiceFarmState {
  farm_name?: string;

  total_farm_acres?:
    | number;

  banana_area_acres?:
    | number;

