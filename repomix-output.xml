import type {
  LocationSearchRequest,
  LocationSearchResponse,
  ParcelCandidate,
} from "../types/farmMap";

const API_BASE =
  import.meta.env.VITE_API_BASE_URL ||
  "http://127.0.0.1:8000";

export type {
  LocationSearchRequest,
  LocationSearchResponse,
  ParcelCandidate,
};

export async function searchReferenceParcels(
  request: LocationSearchRequest
): Promise<LocationSearchResponse> {

  const response = await fetch(
    `${API_BASE}/farm/location/search`,
    {
      method: "POST",

      headers: {
        "Content-Type": "application/json",
      },

      body: JSON.stringify(request),
    }
  );

  if (!response.ok) {

    const message =
      await response.text();

    throw new Error(
      message ||
      "Reference parcel search failed."
    );
  }

  return response.json();
}


export async function saveFarmLocation(
  payload: Record<string, unknown>
) {

  const response = await fetch(
    `${API_BASE}/farm/location`,
    {
      method: "POST",

      headers: {
        "Content-Type": "application/json",
      },

      body: JSON.stringify(payload),
    }
  );

  if (!response.ok) {

    const message =
      await response.text();

    throw new Error(
      message ||
      "Farm location could not be saved."
    );
  }

  return response.json();
}


export async function createFarmProfile(
  payload: Record<string, unknown>
) {

  const response = await fetch(
    `${API_BASE}/farm/profile`,
    {
      method: "POST",

      headers: {
        "Content-Type": "application/json",
      },

      body: JSON.stringify(payload),
    }
  );

  if (!response.ok) {

    const message =
      await response.text();

    throw new Error(
      message ||
      "Farm profile could not be created."
    );
  }

  return response.json();
}
