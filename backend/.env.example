AWS_PROFILE=vazhaiguard
AWS_REGION=ap-south-1
VAZHAIGUARD_DYNAMODB_TABLE=fai-tce-team53-vazhaiguard-farms
# Existing Team 53 inspection bucket; confirm write permission and intended use before enabling uploads.
VAZHAIGUARD_S3_BUCKET=fai-tce-team53-vazhaiguard-inspections-529170326035
VAZHAIGUARD_S3_PREFIX=inspections
VAZHAIGUARD_LOCAL_VISION_ENABLED=true
VAZHAIGUARD_LOCAL_VISION_MODEL=qwen2.5vl:3b
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_TIMEOUT_SECONDS=90
VAZHAIGUARD_VISION_MODEL=apac.amazon.nova-lite-v1:0
VAZHAIGUARD_VISION_FALLBACK_MODEL=apac.amazon.nova-pro-v1:0
VAZHAIGUARD_TEXT_MODEL=mistral.ministral-3-8b-instruct
CDSE_CLIENT_ID=
CDSE_CLIENT_SECRET=
# In cloud hosting, inject CDSE secrets from AWS Secrets Manager; never commit real values.
