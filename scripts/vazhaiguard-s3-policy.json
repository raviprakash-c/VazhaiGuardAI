{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "VazhaiGuardInspectionObjects",
      "Effect": "Allow",
      "Action": [
        "s3:GetObject",
        "s3:PutObject"
      ],
      "Resource": [
        "arn:aws:s3:::vazhaiguard-inspections-*/*"
      ]
    },
    {
      "Sid": "VazhaiGuardInspectionBucketCheck",
      "Effect": "Allow",
      "Action": [
        "s3:ListBucket"
      ],
      "Resource": [
        "arn:aws:s3:::vazhaiguard-inspections-*"
      ]
    }
  ]
}
